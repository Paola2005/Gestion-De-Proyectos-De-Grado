<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%-- topbar.jspf - Barra superior común con diseño idéntico al PDF --%>

<header class="top-header">
  <div class="left-box">
    <button class="toggle-btn" id="sidebarToggle" type="button" aria-label="Menu">
      <i class="fas fa-bars"></i>
    </button>
    <h1 class="welcome-title">Bienvenido</h1>
  </div>
  <div class="user-profile-box">
    <div class="user-avatar">
      <c:out value="${fn:substring(sessionScope.usuario_nombres, 0, 1)}${fn:substring(sessionScope.usuario_apellidos, 0, 1)}" />
    </div>
    <div>
      <div class="user-meta-name">
        <c:out value="${sessionScope.usuario_nombres} ${sessionScope.usuario_apellidos}" />
      </div>
      <div class="user-meta-role">
        <c:choose>
          <c:when test="${not empty sessionScope.rol_activo}"><span class="text-capitalize">${sessionScope.rol_activo}</span> - Ingeniería De Sistemas</c:when>
          <c:when test="${fn:contains(sessionScope.roles, 'comite')}">Comité - Ingeniería De Sistemas</c:when>
          <c:when test="${fn:contains(sessionScope.roles, 'administrador')}">Administrador - Ingeniería De Sistemas</c:when>
          <c:when test="${fn:contains(sessionScope.roles, 'docente')}">Docente - Ingeniería De Sistemas</c:when>
          <c:when test="${fn:contains(sessionScope.roles, 'estudiante')}">Estudiante - Ingeniería De Sistemas</c:when>
          <c:otherwise><c:out value="${sessionScope.rol_principal}" /></c:otherwise>
        </c:choose>
        <c:if test="${not empty sessionScope.roles and fn:length(fn:split(sessionScope.roles, ',')) > 1}">
          <a href="${pageContext.request.contextPath}/elegir_rol.jsp" class="ms-1 small">Cambiar</a>
        </c:if>
      </div>
    </div>
  </div>
</header>